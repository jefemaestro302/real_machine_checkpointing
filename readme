======================================================================================
################################ CHECKPOINT.H ########################################

defines: 
    CKPT_MAGIC   0x474D35434B505400ULL  /* "GM5CKPT\0" */
    CKPT_VERSION 1
    CKPT_REGIONS_OFFSET  (sizeof(ckpt_header_t))
    CKPT_DATA_OFFSET(n)  (CKPT_REGIONS_OFFSET + (n)*sizeof(ckpt_region_t))
    CKPT_PROT_R  0x01
    CKPT_PROT_W  0x02
    CKPT_PROT_X  0x04
    CKPT_FLAG_ANONYMOUS  0x01   /* not backed by a file */
    CKPT_FLAG_STACK      0x02   /* this is the stack region */
    CKPT_FLAG_HEAP       0x04
    CKPT_FLAG_TEXT       0x08   /* .text/.rodata - usually skip payload */
    CKPT_FLAG_DATA       0x10   /* .data/.bss */
    CKPT_FLAG_SKIP

structs:
    ckpt_regs_t {
        /* General purpose */
        uint64_t rax, rbx, rcx, rdx;
        uint64_t rsi, rdi, rbp, rsp;
        uint64_t r8,  r9,  r10, r11;
        uint64_t r12, r13, r14, r15;
        /* Control */
        uint64_t rip;
        uint64_t rflags;
        /* Segment selectors (values at checkpoint time) */
        uint64_t cs, ss, ds, es, fs, gs;
        /* FS/GS base (TLS) */
        uint64_t fs_base, gs_base;}

//Esta struct lo que hace es representar mediante variables de código los valores que se encuentran en el fichero /proc/self/maps. Este fichero contiene una representación visual del segmentos de memoria y la tabla de páginas del proceso que lo ejecuta.

    ckpt_region_t {   
         uint64_t start;       /* region start VA */
         uint64_t end;         /* region end VA   (exclusive) */
         uint32_t prot;        /* CKPT_PROT_* bitmask */
         uint32_t flags;       /* CKPT_FLAG_* bitmask */
         uint64_t file_offset; /* offset into the dump file where raw bytes start */
         uint64_t data_size;   /* number of raw bytes stored (may == 0 for SKIP)  */
         char name[64];    /* /proc/maps name field, for diagnostics */}

    ckpt_header_t {
         uint64_t     magic;
         uint32_t     version;
         uint32_t     num_regions;
         ckpt_regs_t  regs;           /* CPU state at ROI entry */
         uint64_t     roi_entry_rip;  /* RIP we want to jump to after restore */
         uint64_t     stack_va;       /* the stack VA we saved (for the loader) */
         uint8_t      padding[48];    /* reserved, must be zero */}



======================================================================================


======================================================================================
#################################### DUMPER.H ########################################

/**
 * ckpt_dump() - Capture current process state and write it to a file.
 *
 * @path: Output file path (e.g. "dump.ckpt")
 *
 * Call this at the ROI entry point inside your Tailbench application.
 * When the loader restores the checkpoint, execution will resume at the
 * instruction immediately following the call to ckpt_dump() in the caller.
 *
 * Returns 0 on success, -1 on error.
 *
 * NOTE: After ckpt_dump() returns, the original application continues
 *       executing normally (first run semantics).  The loader will invoke
 *       it again starting at the ROI entry (restore semantics).
 */
int ckpt_dump(const char *path);

======================================================================================

======================================================================================
#################################### DUMPER.c ########################################

defines:
    MAX_REGIONS 256
    _GNU_SOURCE

funciones:

//Método que escribe en un fichero de texto (que se pasa como argumento y ruta) los registros y el mapa de memoria virtual de un proceso (el proceso que llama a este método). Parece que funciona primero metiendo datos de prueba y luego datos reales. Usa librerías (open) en vez de llamadas al sistema (fopen).
    -int ckpt_dump_impl(const char *path, ckpt_regs_t *r);
        
//Método que convierte el fichero /proc/self/maps en un vector de ckpt_region_t tan largo como filas tenga ese archivo. Cada línea del fichero se traduce a una region. El límite son 256 filas.
    -static int parse_maps(
        ckpt_region_t *regions,
        int max_regions,
        uint64_t loader_va_hint)
        

//Escribe en trozos de 4KiB la región de memoria que se le pasa en un archivo que le pasas como file descriptor. No escribe las regiones de memoria que tengan la flag activada de saltar (CKPT_FLAG_SKIP). Se marcan con esta flag las regiones que sean del loader, que no tengan permisos de lectura y que sean vsyscalls.
    -static int dump_region_data(
        int fd, 
        ckpt_region_t *reg)

======================================================================================
#################################### libckpt.c ########################################
defines:
    _GNU_SOURCE
    STATIC_BUILD

funciones:
//Método que intercepta INT3 (instruccion 0xCC) propia de la microarquitectura x86 y calcula la direccion de memoria correcta para la restauracion que, debido a como Linux trata las Traps, será la direccion del RIP menos 1 byte, al ser la instruccion de exactamente 1 byte de largo.
    -static void sigtrap-handler(
        int sig, 
        siginfo_t *info, 
        void *ctx)
    
