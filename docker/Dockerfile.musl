FROM alpine:latest

LABEL description="Alpine-based build environment for compiling static, AVX-free binaries using musl libc"

# Install build dependencies
RUN apk update && apk add --no-cache \
    build-base \
    gcc \
    g++ \
    make \
    bash \
    python3 \
    linux-headers

# Set standard CFLAGS for building AVX-free static binaries
ENV CFLAGS="-O2 -mno-avx -mno-avx2 -mno-sse3 -mno-ssse3 -mno-sse4.1 -mno-sse4.2 -static -DSTATIC_BUILD"
ENV CXXFLAGS="${CFLAGS}"
ENV LDFLAGS="-static"

WORKDIR /workspace

CMD ["/bin/bash"]
